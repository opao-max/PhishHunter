# PhishHunter configuration (copy to .env if your runner loads it)
# Default is fully offline: deterministic mock LLM + mock threat intel.
PHISHHUNTER_LLM_PROVIDER=mock

# Real provider examples (all optional):
# PHISHHUNTER_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# PHISHHUNTER_LLM_MODEL=claude-sonnet-5-5

# PHISHHUNTER_LLM_PROVIDER=openai
# PHISHHUNTER_LLM_API_KEY=sk-...
# PHISHHUNTER_LLM_BASE_URL=https://api.deepseek.com/v1
# PHISHHUNTER_LLM_MODEL=deepseek-chat

# Agent / policy
PHISHHUNTER_PLANNER=heuristic
PHISHHUNTER_MAX_TOOL_CALLS=12
PHISHHUNTER_BLOCK_THRESHOLD=70
PHISHHUNTER_QUARANTINE_THRESHOLD=40
# Owned domains: authentication pass + internal context exempts quoted injection
# in legitimate security-awareness mail. Comma-separated.
PHISHHUNTER_INTERNAL_DOMAINS=company.com

# Safety: keep false. The prototype never visits URLs by default.
PHISHHUNTER_ALLOW_NETWORK=0